# chromadb@1.x declares an optional peer dependency on @google/generative-ai@^0.1.1
# so that its own built-in embedding helpers can call Gemini. We pin 0.14.x
# because that is the version whose generateContent/embedContent surface we use,
# and we supply embeddings ourselves rather than through chromadb's helpers.
# The peer is optional, so accepting the mismatch is safe.
legacy-peer-deps=true
