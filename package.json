{
  "name": "trace-ai-backend",
  "version": "2.0.0",
  "description": "Trace.AI — organisational intelligence engine: ingests Gmail, Slack and Google Docs, extracts structured reasoning with Gemini, and answers questions with citations.",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "reset": "node reset.js",
    "test:smoke": "node test_smoke.js",
    "test:auth": "node test_auth.js",
    "test:datastore": "node test_datastore.js",
    "test:scheduler": "node test_scheduler.js",
    "test:transcript": "node test_transcript.js",
    "test:transcript:e2e": "node test_transcript_e2e.js",
    "test:sync": "powershell -NoProfile -ExecutionPolicy Bypass -File test_sync.ps1",
    "show:db": "node show_datastores.js",
    "show:vectors": "node show_vectors.js",
    "backfill:graph": "node backfill_graph.js",
    "backfill:vectors": "node backfill_vectors.js",
    "bulk:slack": "node bulk_slack.js",
    "purge:slack": "node purge_slack.js",
    "db:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-datastores.ps1",
    "db:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-datastores.ps1 -Stop"
  },
  "dependencies": {
    "@google/generative-ai": "^0.14.0",
    "@slack/web-api": "^7.2.0",
    "bcryptjs": "^3.0.3",
    "chromadb": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "googleapis": "^140.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.4.1",
    "neo4j-driver": "^5.21.0",
    "node-cron": "^4.2.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.3"
  }
}
