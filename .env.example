PORT=5000

# Authentication
JWT_SECRET=replace_with_a_long_random_secret

# MongoDB (Required for users and document storage)
MONGO_URI=mongodb://localhost:27017/orgmind

# Groq AI (Required for answering questions and extraction)
GROQ_API_KEY=replace_with_your_groq_api_key

# Neo4j (Graph Database - Optional but recommended)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace_with_your_neo4j_password

# Slack Integration (Optional: requires an xoxb bot token)
SLACK_BOT_TOKEN=replace_with_your_slack_bot_token

# Google OAuth for Gmail and Google Docs (Optional)
GMAIL_CLIENT_ID=replace_with_your_google_oauth_client_id
GMAIL_CLIENT_SECRET=replace_with_your_google_oauth_client_secret
GMAIL_REDIRECT_URI=http://localhost:5000/auth/google/callback
GOOGLE_DRIVE_FOLDER_ID=replace_with_your_google_drive_folder_id

# ChromaDB runs locally; no API key is required.
# Expected URL: http://localhost:8000
